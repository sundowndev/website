{
  "rewrites": [
    { "source": "/agent", "destination": "/agent.md" },
    { "source": "/(.*)", "destination": "/" }
  ],
  "headers": [
    {
      "source": "/agent.md",
      "headers": [
        { "key": "Content-Type", "value": "text/markdown; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
